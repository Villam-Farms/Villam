{
  "name": "villam",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "./start.sh",
    "dev:ios": "EXPO_PUBLIC_API_URL=http://127.0.0.1:8001 ./start.sh",
    "frontend:start": "npm --prefix frontend run start",
    "backend:start": "uvicorn app.main:app --reload --app-dir backend",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "test": "npm --prefix frontend test && PYTHONPATH=backend backend/.venv/bin/python -m unittest discover -s backend/tests -v",
    "test:frontend": "npm --prefix frontend test",
    "test:backend": "PYTHONPATH=backend backend/.venv/bin/python -m unittest discover -s backend/tests -v"
  },
  "dependencies": {
    "expo": "^54.0.37",
    "react": "19.1.0",
    "react-native": "0.81.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
